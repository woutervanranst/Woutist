{
  "name": "woutist",
  "private": true,
  "description": "Woutist: a Microsoft To Do client (web/PWA) built on Microsoft Graph",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "web",
    "api"
  ],
  "scripts": {
    "dev": "npm run dev -w @woutist/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "license": "Apache-2.0"
}
