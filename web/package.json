{
  "name": "@woutist/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -b --noEmit",
    "test": "TZ=Europe/Brussels vitest run",
    "test:watch": "TZ=Europe/Brussels vitest",
    "generate-pwa-assets": "pwa-assets-generator",
    "android:sync": "npm run build && cap sync android",
    "android:run": "npm run android:sync && cd android && JAVA_HOME=${JAVA_HOME:-/opt/homebrew/opt/openjdk@21} ./gradlew installDebug && adb shell am start -n com.wouteronarchitecture.woutist.debug/com.wouteronarchitecture.woutist.MainActivity"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.29.0",
    "@azure/msal-react": "^5.8.1",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fluentui/react-components": "^9.75.1",
    "@fluentui/react-datepicker-compat": "^0.6.40",
    "@fluentui/react-icons": "^2.0.345",
    "@fluentui/react-timepicker-compat": "^0.4.42",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@woutist/contracts": "*",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "@microsoft/microsoft-graph-types": "^2.43.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^30.1.3",
    "msw": "^3.0.4",
    "oxlint": "^1.92.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "license": "Apache-2.0"
}
